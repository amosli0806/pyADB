/* ==========================================================================
   捕虫师 · 全局样式
   设计方向：工业实用（Industrial / utilitarian）
   —— 暖白纸底、发丝边框、高信息密度，颜色只用来表达状态，不做装饰。

   说明：Qt QSS 没有变量机制，也不支持 box-shadow / cursor / transition，
   因此下面重复书写色值，并在每段注明用途。改主题时按块替换即可。

   调色板（唯一的取色来源）
     底色   BG        #F6F4F0     暖白纸
     面板   SURFACE   #FFFFFF
     次面   ALT       #FBFAF7
     悬停   HOVER     #F1EDE6
     发丝线 BORDER    #E3DED5
     强线   STRONG    #CFC7BA
     正文   TEXT      #1F1D1A     近黑（不用纯黑）
     次要   MUTED     #6E675D
     弱化   FAINT     #9C9488
     执行   RUN       #2F6B45     低饱和墨绿（语义：执行 / 运行中 / 成功）
     停止   STOP      #A6402F     砖红（语义：停止 / 删除 / 失败）
     提醒   WARN      #B0761F     琥珀
     信息   INFO      #3E6E8E     灰蓝

   圆角：小件 4px / 控件 6px / 面板 8px
   字阶：11px 标签 · 12px 正文 · 13px 列表项 · 15px 区块标题
   ========================================================================== */

/* ==================== 基底 ==================== */
QWidget {
    background-color: #F6F4F0;
    color: #1F1D1A;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 12px;
    margin: 0px;
    padding: 0px;
}

QMainWindow,
QDialog {
    background-color: #F6F4F0;
}

/* ==================== 工具栏 ==================== */
QToolBar {
    background-color: #FBFAF7;
    border: none;
    border-bottom: 1px solid #E3DED5;
    spacing: 8px;
    padding: 10px 12px;
}

QToolBar QLabel {
    color: #6E675D;
    font-size: 11px;
}

QToolBar::separator {
    background-color: #E3DED5;
    width: 1px;
    margin: 4px 6px;
}

/* ==================== 输入框 ==================== */
QLineEdit {
    background-color: #FFFFFF;
    color: #1F1D1A;
    border: 1px solid #E3DED5;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 18px;
    selection-background-color: #2F6B45;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #CFC7BA;
}

QLineEdit:focus {
    border-color: #2F6B45;
}

/* 输出路径：等宽字，弱化的只读态 */
QLineEdit#outputPathEdit {
    font-family: "Cascadia Mono", "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    color: #6E675D;
    background-color: #FFFFFF;
    padding: 6px 10px;
}

QLineEdit#searchEdit {
    padding: 6px 10px;
    min-height: 18px;
}

/* ==================== 下拉框 ==================== */
QComboBox {
    background-color: #FFFFFF;
    color: #1F1D1A;
    border: 1px solid #E3DED5;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 18px;
    min-width: 180px;
}

QComboBox:hover {
    border-color: #CFC7BA;
}

QComboBox:focus {
    border-color: #2F6B45;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E3DED5;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: #F1EDE6;
    selection-color: #1F1D1A;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 2px 8px;
    border-radius: 4px;
}

/* ==================== 按钮：基础（次级 / 描边） ==================== */
QPushButton {
    background-color: #FFFFFF;
    color: #1F1D1A;
    border: 1px solid #E3DED5;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 44px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #F1EDE6;
    border-color: #CFC7BA;
}

QPushButton:pressed {
    background-color: #E8E2D8;
}

QPushButton:disabled {
    background-color: #F3F0EA;
    border-color: #E7E2D9;
    color: #B3ACA0;
}

QPushButton:focus {
    border-color: #2F6B45;
}

/* 主操作：实心墨绿（语义"执行/确定"，全屏只留这一处实心） */
QPushButton#primaryBtn {
    background-color: #2F6B45;
    color: #FFFFFF;
    border: 1px solid #2F6B45;
    padding: 6px 16px;
}

QPushButton#primaryBtn:hover {
    background-color: #387A50;
    border-color: #387A50;
}

QPushButton#primaryBtn:pressed {
    background-color: #27593A;
}

QPushButton#primaryBtn:disabled {
    background-color: #D8D2C8;
    border-color: #D8D2C8;
    color: #FFFFFF;
}

/* 破坏性操作：描边砖红，悬停才填充 */
QPushButton#dangerBtn {
    background-color: #FFFFFF;
    color: #A6402F;
    border: 1px solid #E8CFC9;
    padding: 6px 12px;
}

QPushButton#dangerBtn:hover {
    background-color: #FBEFEC;
    border-color: #A6402F;
}

QPushButton#dangerBtn:pressed {
    background-color: #F5DFD9;
}

/* 停止类：实心砖红 —— 运行时唯一需要一眼看见的动作 */
QPushButton#stopBtn {
    background-color: #A6402F;
    color: #FFFFFF;
    border: 1px solid #A6402F;
    padding: 6px 16px;
}

QPushButton#stopBtn:hover {
    background-color: #B94C39;
    border-color: #B94C39;
}

QPushButton#stopBtn:pressed {
    background-color: #8C3427;
}

QPushButton#stopBtn:disabled {
    background-color: #D8D2C8;
    border-color: #D8D2C8;
    color: #FFFFFF;
}

/* 警告类：描边琥珀（清除数据 / 恢复默认等） */
QPushButton#warnBtn {
    background-color: #FFFFFF;
    color: #B0761F;
    border: 1px solid #ECD9BC;
    padding: 6px 12px;
}

QPushButton#warnBtn:hover {
    background-color: #FBF3E6;
    border-color: #B0761F;
}

QPushButton#warnBtn:pressed {
    background-color: #F6E8D2;
}

QPushButton#warnBtn:disabled {
    background-color: #F3F0EA;
    border-color: #E7E2D9;
    color: #B3ACA0;
}

/* 录制按钮：宽度由代码固定，这里只补内边距 */
QPushButton#recordBtn {
    padding: 6px 16px;
}

/* 纯文本按钮（搜索框内的清除 ×） */
QPushButton#linkBtn {
    background-color: transparent;
    border: none;
    color: #6E675D;
    padding: 0px 6px;
    min-width: 20px;
}

QPushButton#linkBtn:hover {
    background-color: transparent;
    color: #1F1D1A;
}

/* 纯图标按钮（刷新等）32×32 */
QPushButton#iconBtn {
    background-color: #FFFFFF;
    border: 1px solid #E3DED5;
    border-radius: 6px;
    padding: 0px;
    min-width: 32px;
    max-width: 32px;
    min-height: 30px;
    max-height: 30px;
}

QPushButton#iconBtn:hover {
    background-color: #F1EDE6;
    border-color: #CFC7BA;
}

/* 快捷功能：无边框幽灵按钮，悬停才显底 */
QPushButton#quickBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #1F1D1A;
    padding: 4px 6px;
}

QPushButton#quickBtn:hover {
    background-color: #F1EDE6;
    border-color: #E3DED5;
}

QPushButton#quickBtn:pressed {
    background-color: #E8E2D8;
}

/* ==================== 列表行内的执行按钮 ==================== */
/* idle：描边绿，安静；running：实心红（停止）；busy：禁用灰 */
QPushButton#runBtn {
    border-radius: 6px;
    padding: 0px 6px;
    min-width: 26px;
    max-width: 26px;
    min-height: 24px;
    max-height: 24px;
    font-size: 11px;
}

QPushButton#runBtn[state="idle"] {
    background-color: #FFFFFF;
    border: 1px solid #A9C6B4;
    color: #2F6B45;
}

QPushButton#runBtn[state="idle"]:hover {
    background-color: #EDF4EF;
    border-color: #2F6B45;
}

QPushButton#runBtn[state="running"] {
    background-color: #A6402F;
    border: 1px solid #A6402F;
    color: #FFFFFF;
}

QPushButton#runBtn[state="running"]:hover {
    background-color: #B94C39;
    border-color: #B94C39;
}

QPushButton#runBtn[state="busy"] {
    background-color: #F3F0EA;
    border: 1px solid #E7E2D9;
    color: #B3ACA0;
}

/* ==================== 命令列表 ==================== */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E3DED5;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    border: none;
    border-bottom: 1px solid #F0ECE4;
    padding: 0px;
}

QListWidget::item:hover {
    background-color: #FBFAF7;
}

QListWidget::item:selected {
    background-color: #F1EDE6;
    color: #1F1D1A;
}

/* 行容器透明，让列表底色透出来 */
QWidget#commandRow {
    background-color: transparent;
}

QWidget#commandRow QLabel {
    background-color: transparent;
}

QCheckBox {
    background-color: transparent;
    spacing: 8px;
    color: #1F1D1A;
    font-size: 13px;
}

/* 勾选框：必须显式绘制，否则设置了样式表后 Qt 会丢掉原生 indicator */
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #CFC7BA;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #2F6B45;
}

QCheckBox::indicator:checked {
    background-color: #2F6B45;
    border-color: #2F6B45;
    image: url({ASSETS}/check.svg);
}

QCheckBox::indicator:disabled {
    background-color: #F3F0EA;
    border-color: #E7E2D9;
}

/* ==================== 日志输出 ==================== */
QTextEdit,
QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1F1D1A;
    border: 1px solid #E3DED5;
    border-radius: 8px;
    padding: 10px 12px;
    font-family: "Cascadia Mono", "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #2F6B45;
    selection-color: #FFFFFF;
}

/* ==================== 滚动条 ==================== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #D5CEC2;
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #BDB4A5;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #D5CEC2;
    border-radius: 5px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #BDB4A5;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    background: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ==================== 菜单 ==================== */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E3DED5;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 14px 7px 10px;
    margin: 1px 2px;
    border-radius: 4px;
    color: #1F1D1A;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #F1EDE6;
    color: #1F1D1A;
}

QMenu::separator {
    height: 1px;
    background-color: #E3DED5;
    margin: 6px 8px;
}

/* 隐藏菜单按钮右侧的下拉箭头 */
QPushButton#menuButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

/* ==================== 分区标题（列表上方 / 日志上方） ==================== */
QLabel#sectionLabel {
    background-color: transparent;
    color: #9C9488;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* ==================== 分割器 ==================== */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 8px;
}

/* ==================== 表单类控件（对话框内） ==================== */
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E3DED5;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 18px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #2F6B45;
}

QGroupBox {
    background-color: transparent;
    border: 1px solid #E3DED5;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #6E675D;
}

QToolTip {
    background-color: #1F1D1A;
    color: #FBFAF7;
    border: none;
    padding: 6px 8px;
    border-radius: 4px;
}

/* ==================== 日志输出配色（代码里插入 HTML 时使用） ==================== */
